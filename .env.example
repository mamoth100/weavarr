# Copy this file to .env.local and fill in what you use - everything is
# optional and the app degrades gracefully with anything left blank
# (services just show as "not configured" instead of erroring).
# Generated from lib/settings.ts's SETTINGS_SCHEMA - keep in sync if that changes.

# --- TMDB (metadata) ---
TMDB_TOKEN=

# --- OMDb (metadata) ---
OMDB_API_KEY=

# --- Trakt (metadata) ---
TRAKT_CLIENT_ID=

# --- Radarr ---
RADARR_URL=
RADARR_KEY=
RADARR_DEFAULT_PROFILE=
RADARR_HIGHEST_PROFILE=

# --- Sonarr ---
SONARR_URL=
SONARR_KEY=
SONARR_DEFAULT_PROFILE=
SONARR_HIGHEST_PROFILE=

# --- SABnzbd ---
ENABLE_SABNZBD=false
SABNZBD_URL=
SABNZBD_API_KEY=

# --- NZBGet ---
ENABLE_NZBGET=false
NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=

# --- Plex ---
ENABLE_PLEX=false
PLEX_URL=
PLEX_TOKEN=

# --- Jellyfin ---
ENABLE_JELLYFIN=false
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# --- Watched sync between Plex/Jellyfin ---
ENABLE_WATCHED_SYNC=false

# --- Pushover notifications ---
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_NOTIFY_IMPORTS=false
PUSHOVER_NOTIFY_ALERTS=false

# --- Generic webhook notifications ---
ENABLE_WEBHOOK_NOTIFY=false
WEBHOOK_NOTIFY_URL=
WEBHOOK_NOTIFY_IMPORTS=false
WEBHOOK_NOTIFY_ALERTS=false

# --- Discord notifications ---
ENABLE_DISCORD_NOTIFY=false
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_IMPORTS=false
DISCORD_NOTIFY_ALERTS=false

# --- App behavior ---
ENABLE_IMPORT_NOTIFICATIONS=false
ENABLE_CONNECTION_ALERTS=false
CLEANUP_WATCHED_PERCENT=90
CLEANUP_EXCLUDED_SHOWS=

# --- Menu customization ---
MENU_GENRES=
MENU_LINKS=
